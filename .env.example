# ========================================================
# Saathi - Unified Environment Configuration (Template)
# Copy this file to .env and fill in your credentials
# ========================================================

# Neon PostgreSQL Connection String (ends with sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# Google Gemini API Key (from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model
MODEL=gemini-2.5-flash

# Automated Safe Execution Threshold in INR
AI_LIMIT=10000

# Backend CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API URL
VITE_API_URL=http://localhost:8000

